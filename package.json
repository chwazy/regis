{
  "name": "regis",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "sidecar",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:demo:onboarding": "node scripts/dev.mjs --demo --onboarding",
    "dev:demo:debug": "node scripts/dev.mjs --demo --debug",
    "build": "node scripts/build-app.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check . && npm run lint:rust",
    "lint:rust": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all --check",
    "test": "vitest run && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --workspace",
    "doctor": "node scripts/doctor.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "format": "prettier --write . && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
